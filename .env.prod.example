# Production Secrets (CHANGE THESE!)
APP_SECRET=ChangeMeToAreallyLongRandomString
JWT_PASSPHRASE=ChangeMeToAnotherLongRandomString

# Database Credentials
# COMPOSE_PROFILES=mysql
# DB_CONNECTION=mysql
# MARIADB_DB=ari_db
# MARIADB_USER=ari_user
# MARIADB_PASSWORD=ChangeMeDatabasePassword
# MARIADB_ROOT_PASSWORD=ChangeMeRootPassword

# App Port
APP_PORT=8080

# Observability
# Application version string returned by GET /api/health. Set at build time.
APP_VERSION=0.1.0
# HMAC-SHA256 key for anonymising tenant IDs in structured logs.
# Set to a long random string (e.g. openssl rand -hex 32).
# If empty, tenant IDs are omitted from log context entirely and a startup WARNING is logged.
LOG_TENANT_HASH_KEY=
# Secret token for GET /metrics (Prometheus scrape endpoint).
# Generate with: openssl rand -hex 32
# If empty, the /metrics endpoint returns 404 (feature disabled).
# WARNING: do not expose /metrics publicly. Use compose.monitoring.yaml which
# restricts access to the internal Docker monitoring network via Caddy.
METRICS_SECRET=

# AlertManager (monitoring stack only — requires compose.monitoring.yaml)
# Telegram bot token for alert delivery (separate bot from the app notification bot).
# Register with @BotFather: https://t.me/BotFather
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
# Telegram chat ID to receive alerts (use @userinfobot to find your chat ID).
ALERTMANAGER_TELEGRAM_CHAT_ID=

# Grafana (monitoring stack only)
# Must NOT be "admin" — compose.monitoring.yaml exits at startup if this is "admin".
# Generate with: openssl rand -base64 16
GRAFANA_ADMIN_PASSWORD=

# Backup (monitoring stack only — requires compose.monitoring.yaml)
# Restic repository URL. Examples:
#   s3:s3.amazonaws.com/my-bucket/ari-backups
#   sftp:user@host:/backups/ari
#   /local/path/to/repo  (bind-mounted into the backup container)
RESTIC_REPOSITORY=
# Restic encryption passphrase — keep this safe; losing it means losing access to backups.
# Generate with: openssl rand -base64 32
RESTIC_PASSWORD=
# MariaDB backup credentials — only needed when DB_CONNECTION=mysql
# BACKUP_MARIADB_HOST=database
# BACKUP_MARIADB_USER=ari_user
# BACKUP_MARIADB_PASSWORD=ChangeMeDatabasePassword
# BACKUP_MARIADB_DB=ari_db
