FROM php:8.5-cli-alpine

# Install system dependencies
RUN apk add --no-cache \
    git \
    bash \
    icu-dev \
    libzip-dev \
    zip \
    unzip \
    linux-headers

# Install PHP extensions
COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/
RUN install-php-extensions \
    intl \
    zip \
    opcache \
    pcov \
    gd \
    pdo_sqlite \
    pdo_mysql

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer


# Configure PCov
RUN echo "pcov.enabled=0" > /usr/local/etc/php/conf.d/pcov.ini \
    && echo "memory_limit=-1" > /usr/local/etc/php/conf.d/memory-limit.ini

# Configure user
RUN addgroup -g 1000 developer \
    && adduser -u 1000 -G developer -D -s /bin/bash developer

WORKDIR /app
USER developer

# Create symlink for plugins in test environment
# This ensures that even if tests run without volume mounts (e.g. in CI), the structure matches
RUN mkdir -p /app/plugins && \
    ln -s /plugins/GiftPlugin /app/plugins/GiftPlugin
