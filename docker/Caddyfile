:8080 {
	# Global root for frontend
	root * /app/public
	encode zstd gzip

	# Handle API requests (Symfony)
	handle /api/* {
		root * /app/core/public
		php_server
	}

	# Handle Uploads (Direct from Backend Public)
	handle /uploads/* {
		root * /app/core/public
		file_server
	}

	# Handle Public Routes (Symfony)
	handle /public/* {
		root * /app/core/public
		php_server
	}

	# Handle Prometheus metrics endpoint (Symfony — not a static file)
	# Must be listed before the catch-all handle block so Caddy routes it to PHP
	# instead of falling back to the frontend file_server.
	handle /metrics {
		root * /app/core/public
		php_server
	}

	# Handle everything else (Frontend)
	handle {
		# Try to serve file, then directory, then fall back to index.html
		try_files {path} {path}/ /index.html
		file_server
	}

	log {
		output stderr
		level INFO
	}
}
