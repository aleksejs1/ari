# Ari backup cron schedule (UTC times)
# Fields: minute hour dom month dow command
#
# 02:00 — database dump + Restic upload + sentinel
0  2 * * *  /backup.sh db   >> /proc/1/fd/1 2>&1
# 02:30 — file storage backup
30 2 * * *  /backup.sh files >> /proc/1/fd/1 2>&1
# 03:00 — prune old snapshots (GFS: daily=7, weekly=4, monthly=12)
0  3 * * *  /backup.sh prune >> /proc/1/fd/1 2>&1
